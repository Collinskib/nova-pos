# Copy to .env — never commit real values (BUILD.md §15).
# Hub / desktop
POS_DB=pos.db
POS_HOST=127.0.0.1
POS_PORT=5050
# Cloud API (Phase 5) — server-side only, never shipped to clients
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # stays on the cloud API server only (§4.3)
SUPABASE_DB_URL=postgresql://postgres:****@db.your-project.supabase.co:5432/postgres
